rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dev-disclosures/{document=**} {
      allow read;
    }
    match /disclosures/{document=**} {
      // 1. ログイン済みであること
      // 2. 相手の UID でないこと
      // 3. 相手の "limit 50" を弾く（正規アプリの limit なし、または limit 20 のみ許可）
      allow read: if request.auth.uid != null
                  && request.auth.uid != "zpIzrPUBWHUq7IqEhxiEp5PHxXE3"
                  && (request.query.limit == null || request.query.limit <= 20);
    }
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
      match /disclosures/{document=**} {
        allow read: if request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }
    }
    match /companies/{document=**} {
      allow read: if request.auth.uid != null;
    }
    match /settlements/{document=**} {
      allow read: if request.auth.uid != null;
    }
    match /edinets/{document=**} {
      allow read: if request.auth.uid != null;
    }
  }
}
